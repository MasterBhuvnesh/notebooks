% =========================================================================
% notebooks.sty -- the entire look of every document in this repo.
%
% A document never redefines a colour, a heading, or a listing style. It says
%   \usepackage{notebooks}
% and everything below applies. Change a colour here and every PDF follows.
%
% Found via TEXINPUTS, which tools/build.py points at shared/.
% =========================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notebooks}[2026/08/15 Notebooks house style]

\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[margin=2.4cm]{geometry}
\RequirePackage[table]{xcolor}      % [table] is what gives you \rowcolor
\RequirePackage{graphicx}
\RequirePackage{listings}
\RequirePackage{tabularx}
\RequirePackage{booktabs}
\RequirePackage{longtable}           % reference tables that run past one page
\RequirePackage{etoolbox}            % for the \BeforeBeginEnvironment hooks below
\RequirePackage{amssymb}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{microtype}
% Typewriter text is full of "--flag". Without this, the font's dash ligature
% turns it into an en dash and the flag silently reads as "-flag".
\DisableLigatures[-]{family=tt*}

% --- colours (MUST come before hyperref, which references them) ----------
\definecolor{accent}{HTML}{1F5FA9}     % blue: headings, links, rules
\definecolor{accent2}{HTML}{0E7C66}    % teal: field labels, file headings
\definecolor{rulecol}{HTML}{9FBBDD}    % pale blue: rule under a section title
\definecolor{tablehead}{HTML}{E8EFF8}  % table header row fill
\definecolor{codebg}{HTML}{F6F6F4}
\definecolor{codeframe}{HTML}{D8D8D2}
\definecolor{kw}{HTML}{0B5394}
\definecolor{str}{HTML}{1E7B34}
\definecolor{cmt}{HTML}{7A7A7A}

\RequirePackage[colorlinks=true,linkcolor=accent,urlcolor=accent,linktoc=all]{hyperref}

% --- document metadata ---------------------------------------------------
% \notebooktitle is the only required one; the rest are optional and simply
% vanish from the cover when unset.
\gdef\nb@title{Untitled}
\gdef\nb@subtitle{}
\gdef\nb@tagline{}
\gdef\nb@author{}
\gdef\nb@source{}
\newcommand{\notebooktitle}[1]{\gdef\nb@title{#1}\hypersetup{pdftitle={#1}}}
\newcommand{\notebooksubtitle}[1]{\gdef\nb@subtitle{#1}}
\newcommand{\notebooktagline}[1]{\gdef\nb@tagline{#1}}
\newcommand{\notebookauthor}[1]{\gdef\nb@author{#1}\hypersetup{pdfauthor={#1}}}
\newcommand{\notebooksource}[1]{\gdef\nb@source{#1}}

% \notebookcover -- title page + table of contents. One line in the document
% instead of twenty lines of titlepage copy-pasted between files.
\newcommand{\notebookcover}{%
  \begin{titlepage}
  \centering
  \vspace*{4.5cm}
  {\fontsize{56}{60}\selectfont\color{accent}\nb@title\par}
  \vspace{0.6cm}
  {\color{rulecol}\rule{0.42\linewidth}{1.2pt}\par}
  \vspace{0.9cm}
  {\LARGE\color{accent2}\nb@subtitle\par}
  \vspace{2cm}
  {\large\nb@tagline\par}
  \vspace{2.4cm}
  {\Large\nb@author\par}
  \vfill
  {\ttfamily\color{accent}\nb@source\par}
  \vspace{1cm}
  \end{titlepage}
  \tableofcontents
  \newpage}

% Diagram helper: \mmd{01-thing.png}, or \mmd[0.30]{01-thing.png} to cap it lower.
% Width-first, but capped in height so a near-square diagram cannot grow tall
% enough to push the theory onto a second page.
% Path is diagrams/png/ -- .mmd sources live beside it in diagrams/mmd/.
\newcommand{\mmd}[2][0.40]{{\par\smallskip\centering%
  \includegraphics[width=0.96\linewidth,height=#1\textheight,keepaspectratio]{diagrams/png/#2}%
  \par\smallskip}}

% \field{Use case:}{...} -- labelled paragraph, the workhorse of a theory page.
\newcommand{\field}[2]{\par\smallskip\noindent\textbf{\color{accent2}#1} #2\par}

% Inline highlights for recurring terms. LaTeX eats the space after a macro
% name: write "\hlerror\ logs", not "\hlerror logs".
\newcommand{\hlerror}{\colorbox{red!30}{\texttt{error}}}
\newcommand{\hlinfo}{\colorbox{cyan!30}{\texttt{info}}}
\newcommand{\hlwarning}{\colorbox{orange!30}{\texttt{warning}}}

% --- listings ------------------------------------------------------------
% listings has no built-in JavaScript language; define it or lstset errors.
\lstdefinelanguage{JavaScript}{
  keywords={await, async, const, let, var, function, return, if, else, for, of, in,
            new, class, constructor, this, try, catch, Promise, require, resolve, typeof},
  ndkeywords={console, Buffer, process, setTimeout, parseInt, module, exports},
  sensitive=true,
  comment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]',
  morestring=[b]",
  morestring=[b]`,
}

\lstset{
  basicstyle=\ttfamily\footnotesize,
  keywordstyle=\color{kw}\bfseries,
  ndkeywordstyle=\color{kw},
  stringstyle=\color{str},
  commentstyle=\color{cmt}\itshape,
  backgroundcolor=\color{codebg},
  frame=single,
  rulecolor=\color{codeframe},
  framesep=6pt,
  xleftmargin=10pt,
  xrightmargin=2pt,
  breaklines=true,
  breakatwhitespace=true,
  showstringspaces=false,
  columns=fullflexible,
  keepspaces=true,
  upquote=true,
  extendedchars=true,
  % pdflatex cannot typeset raw UTF-8 inside listings; map each glyph you use.
  literate={✓}{{$\checkmark$}}1 {✗}{{$\times$}}1
           {│}{{|}}1 {├}{{+}}1 {└}{{+}}1 {─}{{-}}1,
}

% Each env takes an optional \lstset override, used to shrink a dense page:
%   \begin{js}[basicstyle=\ttfamily\scriptsize]
\lstnewenvironment{py}[1][]{\lstset{language=Python,#1}}{}
\lstnewenvironment{js}[1][]{\lstset{language=JavaScript,#1}}{}
\lstnewenvironment{sh}[1][]{\lstset{language=bash,#1}}{}

% --- table spacing -------------------------------------------------------
% Two blank lines above and below every table, so a table never sits flush
% against the paragraph before or after it. Glue at a page break is discarded,
% so a table at the top of a page does not gain a gap.
\newlength{\tablegap}
\setlength{\tablegap}{2\baselineskip}
\BeforeBeginEnvironment{tabularx}{\par\addvspace{\tablegap}}
\AfterEndEnvironment{tabularx}{\par\addvspace{\tablegap}}
\BeforeBeginEnvironment{tabular}{\par\addvspace{\tablegap}}
\AfterEndEnvironment{tabular}{\par\addvspace{\tablegap}}
\setlength{\LTpre}{\tablegap}        % longtable has its own pre/post skips
\setlength{\LTpost}{\tablegap}

% --- reference tables ----------------------------------------------------
% For command tables long enough to run past a page break. The header row
% repeats on every page and the first column is typewriter, so entries are
% written plain: "git add & Adds changes to the staging area \\".
%   cmdtable   command + description
%   cmdtable3  command + description + example
% The optional argument widens the command column for long command names
% ("terraform state list"); the description column takes what is left.
\newenvironment{cmdtable}[1][3.2cm]
  {\small\frenchspacing\longtable{@{}>{\ttfamily}p{#1} p{\dimexpr\textwidth-#1-2\tabcolsep\relax}@{}}
   \toprule
   \rowcolor{tablehead}\textrm{\bfseries Command} & \bfseries Description \\
   \midrule\endhead}
  {\bottomrule\endlongtable}

% Ends a row AND rules under it, for tables read one line at a time:
%   pwd & Print the working directory & pwd & pwd \nr
% Use plain \\ on the last row of a table, so the rule under it is the
% \bottomrule and not two lines stacked.
\newcommand{\nr}{\\\midrule}

\newenvironment{cmdtable3}[1][3.0cm]
  {\small\frenchspacing\longtable{@{}>{\ttfamily}p{#1} p{5.0cm}
      >{\ttfamily}p{\dimexpr\textwidth-#1-5.0cm-4\tabcolsep\relax}@{}}
   \toprule
   \rowcolor{tablehead}\textrm{\bfseries Command} & \bfseries Description
     & \textrm{\bfseries Example} \\
   \midrule\endhead}
  {\bottomrule\endlongtable}

% cmdtable4 adds a syntax column between the description and the example.
\newenvironment{cmdtable4}[1][2.0cm]
  {\small\frenchspacing\longtable{@{}>{\ttfamily}p{#1} p{4.1cm} >{\ttfamily}p{4.4cm}
      >{\ttfamily}p{\dimexpr\textwidth-#1-4.1cm-4.4cm-6\tabcolsep\relax}@{}}
   \toprule
   \rowcolor{tablehead}\textrm{\bfseries Command} & \bfseries Description
     & \textrm{\bfseries Syntax} & \textrm{\bfseries Example} \\
   \midrule\endhead}
  {\bottomrule\endlongtable}

% --- headings: coloured, larger, NOT bold --------------------------------
\titleformat{\part}[display]{\centering\Huge\color{accent}}{}{0pt}{}
            [{\color{rulecol}\titlerule[1.2pt]}]
\titlespacing*{\part}{0pt}{0pt}{20pt}

% \unitpart{Title} -- a numbered unit divider. Sections restart at 1 inside
% each unit and carry the unit number, so Unit 2's fourth section is 2.4 and
% its second subsection 2.4.2. Books with no units never call this and keep
% plain 1, 2, 3 section numbers.
\newcounter{unit}
\newcommand{\unitpart}[1]{%
  \renewcommand{\thesection}{\theunit.\arabic{section}}%
  \stepcounter{unit}\setcounter{section}{0}%
  \part*{Unit \theunit: #1}}
\titleformat{\section}{\huge\color{accent}}{\thesection.}{0.5em}{}
            [{\color{rulecol}\titlerule[1pt]}]
\titleformat{\subsection}{\Large\color{accent}}{\thesubsection}{0.5em}{}
\titleformat{\subsubsection}{\large\color{accent2}}{}{0em}{}
\titlespacing*{\section}{0pt}{6pt}{10pt}
\titlespacing*{\subsection}{0pt}{14pt}{6pt}
\titlespacing*{\subsubsection}{0pt}{12pt}{4pt}

% Unit-numbered sections ("2.11", "2.11.3") are wider than article's default
% number box, which would run the number into the title in the TOC.
\patchcmd{\l@section}{1.5em}{3.0em}{}{}
\renewcommand*\l@subsection{\@dottedtocline{2}{3.0em}{3.8em}}
\renewcommand*\l@subsubsection{\@dottedtocline{3}{6.8em}{4.8em}}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\itshape\nb@title}
\fancyhead[R]{\small\nb@subtitle}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}

\endinput
