---
config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (ElasticBlockStoreVolume, Ec2Instance, ElasticBlockStoreSnapshot)
flowchart TD
    subgraph R1[" "]
        direction LR
        C@{ img: "data:image/svg+xml;base64,", label: "1. Create<br/>CreateVolume, 1 GiB to 16 TiB", pos: "b", w: 56, h: 56, constraint: "on" } --> A@{ img: "data:image/svg+xml;base64,", label: "2. Attach<br/>AttachVolume to one EC2", pos: "b", w: 56, h: 56, constraint: "on" } --> U[3. Attached and in use<br/>format from the OS,<br/>mount the drive]
    end
    subgraph R2[" "]
        direction LR
        S@{ img: "data:image/svg+xml;base64,", label: "4. CreateSnapshot<br/>point-in-time copy to S3", pos: "b", w: 56, h: 56, constraint: "on" } --> DT[5. Detach<br/>DetachVolume<br/>can be re-attached] --> DL[6. Deleted<br/>DeleteVolume]
    end
    R1 --> R2
    classDef icon fill:none,stroke:none
    class C,A,S icon
