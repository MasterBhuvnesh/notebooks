---
config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (Route53, ElasticLoadBalancing, Ec2)
flowchart LR
    subgraph WEIGHTED[Weighted routing]
        direction LR
        R2@{ img: "data:image/svg+xml;base64,", label: "Route 53", pos: "b", w: 56, h: 56, constraint: "on" } -- 90% --> A@{ img: "data:image/svg+xml;base64,", label: "ELB in AZ-a", pos: "b", w: 56, h: 56, constraint: "on" }
        R2 -- 10% --> B@{ img: "data:image/svg+xml;base64,", label: "ELB in AZ-b", pos: "b", w: 56, h: 56, constraint: "on" }
    end
    subgraph SIMPLE[Simple routing]
        direction LR
        R1@{ img: "data:image/svg+xml;base64,", label: "Route 53", pos: "b", w: 56, h: 56, constraint: "on" } --> W1@{ img: "data:image/svg+xml;base64,", label: "One web server", pos: "b", w: 56, h: 56, constraint: "on" }
    end
    classDef icon fill:none,stroke:none
    class R2,A,B,R1,W1 icon
