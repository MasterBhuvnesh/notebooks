---
config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (Route53, User)
flowchart LR
    subgraph GEO[Geolocation routing]
        direction LR
        RG@{ img: "data:image/svg+xml;base64,", label: "Route 53", pos: "b", w: 56, h: 56, constraint: "on" }
        IN[Users in India] --> RG
        EU[Users in Europe] --> RG
        RG -- India --> M2[ap-south-1 Mumbai]
        RG -- Europe --> F[eu-central-1 Frankfurt]
    end
    subgraph LAT[Latency routing]
        direction LR
        UL@{ img: "data:image/svg+xml;base64,", label: "User in Pune", pos: "b", w: 56, h: 56, constraint: "on" } --> RL@{ img: "data:image/svg+xml;base64,", label: "Route 53", pos: "b", w: 56, h: 56, constraint: "on" }
        RL -- lowest latency, 20 ms --> M[ap-south-1 Mumbai]
        RL -. 230 ms .-> V[us-east-1 N. Virginia]
    end
    classDef icon fill:none,stroke:none
    class RG,UL,RL icon
