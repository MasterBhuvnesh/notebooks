config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (Ec2AmiResource, Ec2Instance, IdentityAccessManagementLongTermSecurityCredential, Firewall, ElasticBlockStoreVolume, VirtualPrivateCloud, Ec2)
flowchart TD
    AMI@{ img: "data:image/svg+xml;base64,", label: "AMI<br/>OS + software template", pos: "b", w: 56, h: 56, constraint: "on" }
    IT@{ img: "data:image/svg+xml;base64,", label: "Instance type<br/>vCPU, memory", pos: "b", w: 56, h: 56, constraint: "on" }
    KP@{ img: "data:image/svg+xml;base64,", label: "Key pair<br/>SSH / RDP login", pos: "b", w: 56, h: 56, constraint: "on" }
    SG@{ img: "data:image/svg+xml;base64,", label: "Security group<br/>virtual firewall", pos: "b", w: 56, h: 56, constraint: "on" }
    EBS@{ img: "data:image/svg+xml;base64,", label: "Amazon EBS<br/>root and data disks", pos: "b", w: 56, h: 56, constraint: "on" }
    VPC@{ img: "data:image/svg+xml;base64,", label: "VPC and subnet<br/>private network", pos: "b", w: 56, h: 56, constraint: "on" }
    EC2@{ img: "data:image/svg+xml;base64,", label: "EC2 instance", pos: "b", w: 56, h: 56, constraint: "on" }
    AMI --> EC2
    IT --> EC2
    KP --> EC2
    SG --> EC2
    EBS --> EC2
    VPC --> EC2
    classDef icon fill:none,stroke:none
    class AMI,IT,KP,SG,EBS,VPC,EC2 icon
