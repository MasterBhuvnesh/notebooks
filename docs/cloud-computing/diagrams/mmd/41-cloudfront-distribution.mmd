---
config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (Users, CloudFrontDownloadDistribution, SimpleStorageBucket, Ec2, TraditionalServer)
flowchart LR
    U@{ img: "data:image/svg+xml;base64,", label: "Viewers worldwide", pos: "b", w: 56, h: 56, constraint: "on" }
    CF@{ img: "data:image/svg+xml;base64,", label: "CloudFront distribution<br/>d111.cloudfront.net<br/>or CNAME example.com", pos: "b", w: 56, h: 56, constraint: "on" }
    S3@{ img: "data:image/svg+xml;base64,", label: "S3 bucket<br/>static objects", pos: "b", w: 56, h: 56, constraint: "on" }
    EC@{ img: "data:image/svg+xml;base64,", label: "EC2<br/>dynamic content", pos: "b", w: 56, h: 56, constraint: "on" }
    CU@{ img: "data:image/svg+xml;base64,", label: "Custom origin<br/>third-party content", pos: "b", w: 56, h: 56, constraint: "on" }
    U --> CF
    CF -- /images/* --> S3
    CF -- /api/* --> EC
    CF -- /partner/* --> CU
    classDef icon fill:none,stroke:none
    class U,CF,S3,EC,CU icon
