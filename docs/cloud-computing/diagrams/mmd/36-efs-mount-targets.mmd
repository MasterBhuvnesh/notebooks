---
config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (Ec2Instance, ElasticFileSystem)
flowchart LR
    subgraph REG[Region]
        subgraph VPC[VPC]
            subgraph AZ3[Availability Zone 3]
                E3@{ img: "data:image/svg+xml;base64,", label: "EC2", pos: "b", w: 56, h: 56, constraint: "on" } --> M3[Mount target<br/>NFS v4 endpoint]
            end
            subgraph AZ2[Availability Zone 2]
                E2@{ img: "data:image/svg+xml;base64,", label: "EC2", pos: "b", w: 56, h: 56, constraint: "on" } --> M2[Mount target<br/>NFS v4 endpoint]
            end
            subgraph AZ1[Availability Zone 1]
                E1@{ img: "data:image/svg+xml;base64,", label: "EC2", pos: "b", w: 56, h: 56, constraint: "on" } --> M1[Mount target<br/>NFS v4 endpoint]
            end
        end
        FS@{ img: "data:image/svg+xml;base64,", label: "Amazon EFS file system<br/>stored redundantly across AZs", pos: "b", w: 56, h: 56, constraint: "on" }
    end
    M1 --> FS
    M2 --> FS
    M3 --> FS
    classDef icon fill:none,stroke:none
    class E3,E2,E1,FS icon
