---
config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (Users, SimpleStorageBucketWithObjects, SimpleStorageObject)
flowchart TD
    U@{ img: "data:image/svg+xml;base64,", label: "Clients: Console, CLI, SDK, REST", pos: "b", w: 56, h: 56, constraint: "on" }
    B@{ img: "data:image/svg+xml;base64,", label: "Bucket: college-notes-2026<br/>globally unique, 3 to 63 chars", pos: "b", w: 56, h: 56, constraint: "on" }
    O1@{ img: "data:image/svg+xml;base64,", label: "images/logo.png", pos: "b", w: 56, h: 56, constraint: "on" }
    O2@{ img: "data:image/svg+xml;base64,", label: "logs/app-01.log", pos: "b", w: 56, h: 56, constraint: "on" }
    P[Object = Key + Version ID + Data + Metadata<br/>key up to 1,024 bytes, including the prefix]
    U -- PUT / GET over HTTPS --> B
    B --> O1
    B --> O2
    O1 -.- P
    classDef icon fill:none,stroke:none
    class U,B,O1,O2 icon
