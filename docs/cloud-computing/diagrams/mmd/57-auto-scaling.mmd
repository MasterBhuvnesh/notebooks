---
config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (Users, ElasticLoadBalancing, Ec2Instance, CloudwatchAlarm, AutoScaling)
flowchart LR
    U@{ img: "data:image/svg+xml;base64,", label: "2,000 to 50,000 users", pos: "b", w: 56, h: 56, constraint: "on" }
    LB@{ img: "data:image/svg+xml;base64,", label: "Load balancer", pos: "b", w: 56, h: 56, constraint: "on" }
    subgraph ASG[Auto Scaling group: min 2, max 6]
        I1@{ img: "data:image/svg+xml;base64,", label: "VM 1", pos: "b", w: 56, h: 56, constraint: "on" }
        I2@{ img: "data:image/svg+xml;base64,", label: "VM 2", pos: "b", w: 56, h: 56, constraint: "on" }
        I3@{ img: "data:image/svg+xml;base64,", label: "VM 3, added", pos: "b", w: 56, h: 56, constraint: "on" }
    end
    CW@{ img: "data:image/svg+xml;base64,", label: "Alarm: CPU above 70%", pos: "b", w: 56, h: 56, constraint: "on" }
    AS@{ img: "data:image/svg+xml;base64,", label: "Scaling policy", pos: "b", w: 56, h: 56, constraint: "on" }
    U --> LB
    LB --> I1
    LB --> I2
    LB -.-> I3
    I1 -. metrics .-> CW
    CW --> AS
    AS -- scale out / in --> ASG
    classDef icon fill:none,stroke:none
    class U,LB,I1,I2,I3,CW,AS icon
