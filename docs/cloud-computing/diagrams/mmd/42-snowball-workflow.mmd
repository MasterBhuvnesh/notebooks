---
config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (ManagementConsole, Snowball, OfficeBuilding, S3Standard)
flowchart TD
    subgraph R1[" "]
        direction LR
        J@{ img: "data:image/svg+xml;base64,", label: "1. Create job<br/>size, destination, job type", pos: "b", w: 56, h: 56, constraint: "on" } --> R@{ img: "data:image/svg+xml;base64,", label: "2. AWS ships<br/>the device", pos: "b", w: 56, h: 56, constraint: "on" } --> CP@{ img: "data:image/svg+xml;base64,", label: "3. Connect and copy<br/>NFS or S3 adapter", pos: "b", w: 56, h: 56, constraint: "on" }
    end
    subgraph R2[" "]
        direction LR
        RT[4. Ship the device<br/>back to AWS] --> IM@{ img: "data:image/svg+xml;base64,", label: "5. AWS imports<br/>into the S3 bucket", pos: "b", w: 56, h: 56, constraint: "on" } --> VF[6. Verify the job report,<br/>device erased per<br/>NIST SP 800-88]
    end
    R1 --> R2
    classDef icon fill:none,stroke:none
    class J,R,CP,IM icon
