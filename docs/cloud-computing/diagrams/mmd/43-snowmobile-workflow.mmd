---
config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (OfficeBuilding, Snowmobile, S3Standard)
flowchart TD
    subgraph R1[" "]
        direction LR
        A[1. Assess<br/>data volume, systems,<br/>timeline] --> P[2. Plan<br/>connectivity, security,<br/>transport] --> C@{ img: "data:image/svg+xml;base64,", label: "3. Connect the<br/>source data centre", pos: "b", w: 56, h: 56, constraint: "on" }
    end
    subgraph R2[" "]
        direction LR
        T@{ img: "data:image/svg+xml;base64,", label: "4. Transfer and secure<br/>up to 100 PB per unit", pos: "b", w: 56, h: 56, constraint: "on" } --> TR[5. Truck transports<br/>the unit to AWS] --> I@{ img: "data:image/svg+xml;base64,", label: "6. Import into<br/>AWS storage", pos: "b", w: 56, h: 56, constraint: "on" } --> V[7. Validate<br/>the migration]
    end
    R1 --> R2
    classDef icon fill:none,stroke:none
    class C,T,I icon
