---
config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (Users, Route53, ElasticLoadBalancing)
flowchart LR
    U@{ img: "data:image/svg+xml;base64,", label: "Users", pos: "b", w: 56, h: 56, constraint: "on" } --> R@{ img: "data:image/svg+xml;base64,", label: "Route 53<br/>failover record set", pos: "b", w: 56, h: 56, constraint: "on" }
    HC{{Health checks<br/>on the ELB and the site}}
    R -- primary: active --> P@{ img: "data:image/svg+xml;base64,", label: "Primary ELB", pos: "b", w: 56, h: 56, constraint: "on" }
    R -. secondary: standby .-> S@{ img: "data:image/svg+xml;base64,", label: "Secondary ELB", pos: "b", w: 56, h: 56, constraint: "on" }
    HC -.- P
    HC -.- S
    classDef icon fill:none,stroke:none
    class U,R,P,S icon
