---
config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (SimpleStorageServiceStandard, SimpleStorageServiceStandardIa, SimpleStorageServiceGlacier)
flowchart LR
    A@{ img: "data:image/svg+xml;base64,", label: "S3 Standard<br/>hot, 99.99% available", pos: "b", w: 56, h: 56, constraint: "on" }
    B@{ img: "data:image/svg+xml;base64,", label: "S3 Standard-IA<br/>warm, min 30 days", pos: "b", w: 56, h: 56, constraint: "on" }
    C@{ img: "data:image/svg+xml;base64,", label: "S3 Glacier<br/>cold, min 90 days", pos: "b", w: 56, h: 56, constraint: "on" }
    D((Expire / delete))
    A -- after 30 days --> B
    B -- after 90 days --> C
    C -- after 365 days --> D
    classDef icon fill:none,stroke:none
    class A,B,C icon
