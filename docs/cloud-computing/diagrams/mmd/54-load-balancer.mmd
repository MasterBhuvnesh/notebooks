---
config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (Users, ElasticLoadBalancing, Ec2Instance)
flowchart LR
    U@{ img: "data:image/svg+xml;base64,", label: "Thousands of shoppers", pos: "b", w: 56, h: 56, constraint: "on" }
    LB@{ img: "data:image/svg+xml;base64,", label: "Load balancer<br/>routing rules + health checks", pos: "b", w: 56, h: 56, constraint: "on" }
    A@{ img: "data:image/svg+xml;base64,", label: "Server A: healthy", pos: "b", w: 56, h: 56, constraint: "on" }
    B@{ img: "data:image/svg+xml;base64,", label: "Server B: healthy", pos: "b", w: 56, h: 56, constraint: "on" }
    C@{ img: "data:image/svg+xml;base64,", label: "Server C: failed /health", pos: "b", w: 56, h: 56, constraint: "on" }
    U --> LB
    LB --> A
    LB --> B
    LB -. no new requests .-x C
    classDef icon fill:none,stroke:none
    class U,LB,A,B,C icon
