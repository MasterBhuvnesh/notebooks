---
config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (Ec2Instance, ElasticFileSystemFileSystem)
flowchart LR
    A@{ img: "data:image/svg+xml;base64,", label: "EC2 in sg-allowed", pos: "b", w: 56, h: 56, constraint: "on" }
    B@{ img: "data:image/svg+xml;base64,", label: "EC2 in sg-not-allowed", pos: "b", w: 56, h: 56, constraint: "on" }
    MT[Mount target<br/>security group: permit inbound<br/>NFS from sg-allowed]
    FS@{ img: "data:image/svg+xml;base64,", label: "Customer file system", pos: "b", w: 56, h: 56, constraint: "on" }
    A -- NFS allowed --> MT
    B -. blocked .-x MT
    MT --> FS
    classDef icon fill:none,stroke:none
    class A,B,FS icon
