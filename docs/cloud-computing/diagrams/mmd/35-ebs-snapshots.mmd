---
config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (ElasticBlockStoreVolume, S3Standard)
flowchart LR
    V@{ img: "data:image/svg+xml;base64,", label: "EBS volume", pos: "b", w: 56, h: 56, constraint: "on" }
    S1[Snapshot 1: full copy<br/>blocks A B C D]
    S2[Snapshot 2: incremental<br/>only changed block C']
    S3[Snapshot 3: incremental<br/>changed A' and new block E]
    ST@{ img: "data:image/svg+xml;base64,", label: "Stored in Amazon S3", pos: "b", w: 56, h: 56, constraint: "on" }
    V -- day 1 --> S1
    V -- day 2 --> S2
    V -- day 3 --> S3
    S1 --> ST
    S2 --> ST
    S3 --> ST
    classDef icon fill:none,stroke:none
    class V,ST icon
