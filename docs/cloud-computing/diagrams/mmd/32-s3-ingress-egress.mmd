---
config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (InternetAlt1, VpcEndpoints, DirectConnect, StorageGateway, S3Standard, InternetAlt2, CloudFront, Ec2)
flowchart LR
    subgraph IN[Data ingress]
        direction TB
        I1@{ img: "data:image/svg+xml;base64,", label: "Internet upload", pos: "b", w: 56, h: 56, constraint: "on" }
        I2@{ img: "data:image/svg+xml;base64,", label: "VPC endpoint", pos: "b", w: 56, h: 56, constraint: "on" }
        I3@{ img: "data:image/svg+xml;base64,", label: "Direct Connect", pos: "b", w: 56, h: 56, constraint: "on" }
        I4@{ img: "data:image/svg+xml;base64,", label: "Storage Gateway", pos: "b", w: 56, h: 56, constraint: "on" }
    end
    S3@{ img: "data:image/svg+xml;base64,", label: "Amazon S3", pos: "b", w: 56, h: 56, constraint: "on" }
    subgraph OUT[Data egress]
        direction TB
        E1@{ img: "data:image/svg+xml;base64,", label: "Static website", pos: "b", w: 56, h: 56, constraint: "on" }
        E2@{ img: "data:image/svg+xml;base64,", label: "CloudFront CDN", pos: "b", w: 56, h: 56, constraint: "on" }
        E3@{ img: "data:image/svg+xml;base64,", label: "Amazon EC2", pos: "b", w: 56, h: 56, constraint: "on" }
    end
    I1 --> S3
    I2 --> S3
    I3 --> S3
    I4 --> S3
    S3 --> E1
    S3 -- no transfer charge --> E2
    S3 -- free in same Region --> E3
    classDef icon fill:none,stroke:none
    class I1,I2,I3,I4,S3,E1,E2,E3 icon
