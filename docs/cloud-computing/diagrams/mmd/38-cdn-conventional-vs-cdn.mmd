---
config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (Users, CloudFrontEdgeLocation, TraditionalServer)
flowchart LR
    subgraph WI[With a CDN]
        direction LR
        U2@{ img: "data:image/svg+xml;base64,", label: "Users in Nagpur,<br/>London, Tokyo", pos: "b", w: 56, h: 56, constraint: "on" } -- short hop --> EL@{ img: "data:image/svg+xml;base64,", label: "Nearest edge server<br/>cached copy", pos: "b", w: 56, h: 56, constraint: "on" }
        EL -- only on a cache miss --> O2@{ img: "data:image/svg+xml;base64,", label: "Origin server<br/>in the US", pos: "b", w: 56, h: 56, constraint: "on" }
    end
    subgraph WO[Without a CDN]
        direction LR
        U1@{ img: "data:image/svg+xml;base64,", label: "Users in Nagpur,<br/>London, Tokyo", pos: "b", w: 56, h: 56, constraint: "on" } -- every request travels<br/>the full distance --> O1@{ img: "data:image/svg+xml;base64,", label: "Origin server<br/>in the US", pos: "b", w: 56, h: 56, constraint: "on" }
    end
    classDef icon fill:none,stroke:none
    class U2,EL,O2,U1,O1 icon
