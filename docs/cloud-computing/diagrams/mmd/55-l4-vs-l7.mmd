---
config:
  look: classic
  theme: default
  flowchart:
    curve: basis
    wrappingWidth: 260
---
%% Icons: AWS Architecture Icons via awsicons.dev (ElasticLoadBalancingApplicationLoadBalancer, ElasticLoadBalancingNetworkLoadBalancer)
flowchart LR
    subgraph L7[Layer 7: application]
        direction LR
        C7((Clients)) -- HTTP --> A@{ img: "data:image/svg+xml;base64,", label: "Application LB<br/>looks at URL, headers, cookies", pos: "b", w: 56, h: 56, constraint: "on" }
        A -- /products --> PR[Product servers]
        A -- /payments --> PA[Payment servers]
    end
    subgraph L4[Layer 4: transport]
        direction LR
        C4((Clients)) -- TCP :443 --> N@{ img: "data:image/svg+xml;base64,", label: "Network LB<br/>looks at IP + port", pos: "b", w: 56, h: 56, constraint: "on" }
        N --> P1[Server 1]
        N --> P2[Server 2]
    end
    classDef icon fill:none,stroke:none
    class A,N icon
