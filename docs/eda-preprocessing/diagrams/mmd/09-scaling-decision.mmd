flowchart TD
    B{"Which algorithm?"}
    B -- "Trees, forests, boosting,<br/>Naive Bayes" --> N["NO SCALING NEEDED<br/>splits compare a feature<br/>to itself"]
    B -- "Linear, SVM, kNN,<br/>K-Means, PCA, NN" --> C{"Outliers<br/>present?"}

    C -- "Yes" --> D["RobustScaler,<br/>or log1p then<br/>StandardScaler"]
    C -- "No" --> E{"Is the input<br/>naturally bounded?"}

    E -- "Yes, pixels<br/>or percentages" --> F["MinMaxScaler"]
    E -- "No" --> G["StandardScaler<br/>the default"]

    D --> H["Fit on TRAIN only.<br/>Transform train and test."]
    F --> H
    G --> H

